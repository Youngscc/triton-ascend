# Optional overrides. By default the scripts use the current checkout and
# container name triton-ascend-exp.
REMOTE_PROJECT="/absolute/server/path/to/triton-ascend"
REMOTE_CONTAINER="container-name"

# Optional offline-transfer settings. Configure these only on a workstation
# when the server cannot access GitHub and sync.sh/pull-results.sh are needed.
LOCAL_PROJECT="/absolute/local/path/to/triton-ascend"
REMOTE_HOST="server-ssh-alias"
# Set this only for an rsync-managed server worktree. A normal server clone
# uses the default "auto" mode and its own .git directory.
# REMOTE_SOURCE_MODE="rsync"

# Optional host compiler overrides. The scripts automatically prefer the
# repository-supported clang-15/clang++-15/lld-15 tools, including their
# version-suffixed Ubuntu paths. Set these only for a nonstandard installation.
# REMOTE_HOST_CC="/opt/llvm-15/bin/clang"
# REMOTE_HOST_CXX="/opt/llvm-15/bin/clang++"
# REMOTE_HOST_LLD="/opt/llvm-15/bin/lld"
# REMOTE_HOST_LD_LLD="/opt/llvm-15/bin/ld.lld"
