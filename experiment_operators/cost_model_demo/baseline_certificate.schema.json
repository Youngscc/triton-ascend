{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlanComputeBlock (d,m)=(1,1) UB baseline certificate",
  "type": "object",
  "required": [
    "ub_peak_bytes",
    "no_reuse_required_bytes",
    "used_reuse",
    "profile_id",
    "profile_fingerprint",
    "model_fingerprint",
    "normalized_ir_sha256",
    "intra_cache_num",
    "multibuffer_num",
    "vf_merge_level",
    "entry_graph_complete",
    "entries"
  ],
  "properties": {
    "ub_peak_bytes": {"type": "integer", "minimum": 0},
    "no_reuse_required_bytes": {"type": "integer", "minimum": 0},
    "used_reuse": {"type": "boolean"},
    "profile_id": {"type": "string"},
    "profile_fingerprint": {"type": "string", "minLength": 64, "maxLength": 64},
    "model_fingerprint": {"type": "string", "minLength": 64, "maxLength": 64},
    "ir_sha256": {"type": ["string", "null"], "minLength": 64, "maxLength": 64},
    "normalized_ir_sha256": {"type": "string", "minLength": 64, "maxLength": 64},
    "intra_cache_num": {"const": 1},
    "multibuffer_num": {"const": 1},
    "vf_merge_level": {"const": 0},
    "entry_graph_complete": {"type": "boolean"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entry_id", "size_bytes", "lifetimes"],
        "properties": {
          "entry_id": {"type": "string"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "alignment_bytes": {"type": "integer", "minimum": 1},
          "multiplicity_kind": {"enum": ["single", "fixed", "ordinary"]},
          "fixed_count": {"type": "integer", "minimum": 1},
          "alias_group": {"type": ["string", "null"]},
          "origin": {"type": ["string", "null"]},
          "memory_scope": {"type": "string"},
          "lifetimes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["start", "end"],
              "properties": {
                "start": {"type": "integer", "minimum": 0},
                "end": {"type": "integer", "minimum": 0}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
